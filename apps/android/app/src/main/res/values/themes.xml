<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CloudSSH" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:alertDialogTheme">@style/CloudSSH.Dialog</item>
    </style>

    <style name="CloudSSH.Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/surface</item>
    </style>

    <style name="CloudSSH.TextButton" parent="android:Widget.Material.Button.Borderless">
        <item name="android:textColor">@color/accent</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
