{
  "name": "@cloudssh/ui-web",
  "version": "2.6.8",
  "private": true,
  "description": "内置 UI 包：CloudSSH 网页版前端的同步副本（upstream/ 由 scripts/sync-web-ui.mjs 生成，勿手改）",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "typecheck": "tsc --noEmit -p upstream/frontend/tsconfig.json && tsc --noEmit -p overrides/tsconfig.json",
    "build:mobile": "vite build --mode mobile",
    "dev:mobile": "vite --mode mobile"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.12.4",
    "@codemirror/legacy-modes": "6.5.3",
    "@codemirror/search": "6.7.1",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.9",
    "@lezer/highlight": "1.2.3",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "dompurify": "3.4.13",
    "jsqr": "1.4.0",
    "marked": "18.0.5",
    "qrcode-generator": "1.4.4",
    "trzsz": "1.1.6"
  },
  "devDependencies": {
    "@cloudssh/core": "workspace:*",
    "@tailwindcss/container-queries": "0.1.1",
    "@tailwindcss/forms": "0.5.11",
    "@tauri-apps/api": "^2.12.1",
    "autoprefixer": "10.5.4",
    "postcss": "8.5.23",
    "tailwindcss": "3.4.19",
    "typescript": "5.7.2",
    "vite": "6.4.3"
  }
}
