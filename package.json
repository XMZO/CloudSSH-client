{
  "name": "cloudssh-client",
  "version": "0.1.0",
  "private": true,
  "description": "CloudSSH 桌面客户端（对接已部署的 CloudSSH Worker）",
  "packageManager": "pnpm@11.8.0",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "pnpm run build:ui && pnpm --filter @cloudssh/desktop dev",
    "dev:ui": "node scripts/dev-ui.mjs",
    "build": "pnpm run build:ui && pnpm --filter @cloudssh/desktop build",
    "build:ui": "pnpm --filter @cloudssh/ui-web build",
    "dist:win": "pnpm run build:ui && pnpm --filter @cloudssh/desktop dist:win",
    "sync:web-ui": "node scripts/sync-web-ui.mjs",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test"
  }
}
