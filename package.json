{
  "name": "cloudssh-client",
  "version": "0.3.55",
  "private": true,
  "description": "CloudSSH 客户端（桌面 Electron + Android Tauri 2），对接已部署的 CloudSSH Worker",
  "packageManager": "pnpm@11.8.0",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "pnpm run build:ui && pnpm --filter @cloudssh/desktop dev",
    "dev:ui": "node scripts/dev-ui.mjs",
    "build": "pnpm run build:ui && pnpm --filter @cloudssh/desktop build",
    "build:ui": "pnpm --filter @cloudssh/ui-web build",
    "dist:win": "pnpm run build:ui && pnpm --filter @cloudssh/desktop dist:win",
    "release:win": "pnpm run build:ui && pnpm --filter @cloudssh/desktop release:win && node scripts/publish-release.mjs",
    "sync:web-ui": "node scripts/sync-web-ui.mjs",
    "typecheck": "pnpm -r run typecheck",
    "test": "node scripts/version.mjs check && pnpm -r run test",
    "mobile:dev": "pnpm --filter @cloudssh/mobile tauri dev",
    "android:build": "node scripts/mobile.mjs build",
    "android:build:debug": "node scripts/mobile.mjs build --debug",
    "android:install": "node scripts/mobile.mjs install",
    "android:dev": "node scripts/mobile.mjs dev",
    "update:icon-font": "node scripts/update-icon-font.mjs",
    "cli:build": "pnpm --filter @cloudssh/cli build",
    "cli:install": "pnpm --filter @cloudssh/cli build && node packages/cli/dist/cloudssh.mjs install",
    "cli:shim": "node packages/cli/shim/build.mjs",
    "version:check": "node scripts/version.mjs check",
    "version:set": "node scripts/version.mjs set"
  }
}
