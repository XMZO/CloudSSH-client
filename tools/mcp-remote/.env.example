# 复制成 .env（chmod 600）。值里有 $，要用单引号括起来
# 对外地址（Caddy 上配的域名），Muse 里填的连接器地址是 <PUBLIC_URL>/mcp
PUBLIC_URL='https://mcp.example.com'
# 授权口令的哈希：docker run --rm -it -v "$PWD/cloudssh.mjs:/app/cloudssh.mjs:ro" node:24-slim node /app/cloudssh.mjs mcp http --hash-password
PASSWORD_HASH='scrypt$32768$8$1$…$…'
# 权限：full（与命令行的完全权限一样）、ask（危险命令要 AI 先问你）、read-only（只读，默认）
ACCESS='full'
# 不提供的服务器：跑这个服务的机器自己（上面存着 CloudSSH 的登录），逗号隔开
EXCLUDE='srv-12'
# 固定令牌（可选，给只能填固定 Bearer、不会走 OAuth 的客户端）：名字:SHA-256，多个用逗号隔开。生成：
#   docker run --rm -v "$PWD/cloudssh.mjs:/app/cloudssh.mjs:ro" node:24-slim node /app/cloudssh.mjs mcp http --new-token --label 名字
# 第一行是令牌（只显示这一次，填进客户端的 Authorization: Bearer …），第二行加到这里；删掉一项再重启即吊销
STATIC_TOKENS=''
